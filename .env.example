# Next.js (web) — talks to NELA Cloud API over HTTP only
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Razorpay: do NOT put KEY_SECRET here. Checkout uses keyId from
# POST /v1/billing/razorpay/checkout (backend RAZORPAY_KEY_ID).
# Optional override if you ever need the public key on the client:
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Admin dashboard (/dashboard) — must match nela-backend ADMIN_SESSION_SECRET
# ADMIN_SESSION_SECRET=
# (password is verified by the API; only the session HMAC secret is needed here)

# Optional: GitHub releases rate-limit bypass for installer redirect routes
# GITHUB_TOKEN=
